# solarham-exporter configuration.
#
# Every setting is an environment variable prefixed SOLARHAM_. Any setting
# holding a credential also accepts a _FILE variant naming a file to read the
# value from — SOLARHAM_INFLUX2_TOKEN_FILE, for example. Set one or the other,
# never both.
#
# Precedence: command-line flags, then environment (including _FILE), then a
# config file, then these defaults.
#
# Values shown are the defaults. Uncomment only what you are changing.

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

#SOLARHAM_LOG_LEVEL=info                 # debug | info | warn | error
#SOLARHAM_LOG_FORMAT=json                # json | text

# ---------------------------------------------------------------------------
# HTTP server: /metrics, /healthz, /readyz, /health
# ---------------------------------------------------------------------------

#SOLARHAM_HTTP_ADDR=0.0.0.0:9102
#SOLARHAM_HTTP_READ_TIMEOUT=10s
#SOLARHAM_HTTP_SHUTDOWN_TIMEOUT=10s

# How long a source may go without a successful poll before /readyz reports it
# stale. Zero derives it per source as three of that source's own intervals,
# which is almost always what you want: "recent" means something very different
# for a one-minute source than for an hourly one.
#SOLARHAM_HTTP_STALE_AFTER=0

# Make /readyz fail when any single source is stale, rather than only when none
# is fresh. Off by default: one third-party outage does not stop this instance
# serving, and no restart or traffic shift fixes it. /health stays strict either
# way -- point your uptime monitor there. See docs/ENV_VARS.md.
#SOLARHAM_READY_REQUIRE_ALL=false

# ---------------------------------------------------------------------------
# Source: hamqsl.com
#
# N0NBH's aggregated solar XML. This exporter takes only the HF and VHF band
# conditions, the signal-to-noise estimate and the geomagnetic field wording
# from it, because those are model output nobody else produces. Everything else
# in that feed comes from NOAA first-hand, at better cadence and with cache
# headers.
#
# The interval floor is 15 minutes and is not negotiable. The feed's operator
# asks publicly for hourly polling and has stated he was shut down by his ISP
# once over exactly this load. A configured value below the floor is clamped up
# with a warning.
# ---------------------------------------------------------------------------

#SOLARHAM_HAMQSL_ENABLED=true
#SOLARHAM_HAMQSL_URL=https://www.hamqsl.com/solarxml.php
#SOLARHAM_HAMQSL_INTERVAL=1h
#SOLARHAM_HAMQSL_TIMEOUT=15s
#SOLARHAM_HAMQSL_RETRIES=2

# ---------------------------------------------------------------------------
# Source: NOAA SWPC
#
# Public domain, no API key, no published rate limit. Polled in three tiers
# because SWPC's own cadences range from one minute to one day, and every
# response carries ETag and Last-Modified so repeat polls cost a 304.
# ---------------------------------------------------------------------------

#SOLARHAM_SWPC_ENABLED=true
#SOLARHAM_SWPC_BASE_URL=https://services.swpc.noaa.gov
#SOLARHAM_SWPC_FAST_INTERVAL=1m          # solar wind, Bz, 1-minute Kp, X-ray class, scales, alerts
#SOLARHAM_SWPC_MEDIUM_INTERVAL=5m        # GOES protons and electrons, aurora
#SOLARHAM_SWPC_SLOW_INTERVAL=1h          # F10.7, 3-hourly Kp and A, sunspots, Dst
#SOLARHAM_SWPC_TIMEOUT=20s
#SOLARHAM_SWPC_RETRIES=2

# D-Region Absorption Prediction: the highest frequency substantially absorbed
# by the D layer, on a global grid. It is the most directly propagation-relevant
# thing SWPC publishes, and also by far the most series — which is why it is
# opt-in. GRID_STEP publishes every Nth cell on each axis; 10 keeps it to a few
# hundred series, 1 produces tens of thousands.
#SOLARHAM_SWPC_DRAP_ENABLED=false
#SOLARHAM_SWPC_DRAP_GRID_STEP=10

# ---------------------------------------------------------------------------
# Source: prop.kc2g.com
#
# Ionosonde foF2 and MUF, aggregated from GIRO and INGV. This is the real
# source for the two fields hamqsl.com usually publishes empty.
#
# DISABLED BY DEFAULT ON PURPOSE. The data is CC BY-NC-SA 4.0 and
# NON-COMMERCIAL ONLY. Enabling it accepts that restriction. Attribution is due
# to the ionosonde operators, GIRO, INGV and WWROF.
#
# Coverage is patchy and getting worse: Russia and China stopped sharing in
# 2021, Japan in 2023, the US Space Force withdrew the NEXION network covering
# most of CONUS in 2023, and NOAA shut down its ionosonde distribution in 2024.
# ---------------------------------------------------------------------------

#SOLARHAM_KC2G_ENABLED=false
#SOLARHAM_KC2G_BASE_URL=https://prop.kc2g.com
#SOLARHAM_KC2G_INTERVAL=15m              # floor 5m; new maps are generated every 15m
#SOLARHAM_KC2G_TIMEOUT=20s
#SOLARHAM_KC2G_RETRIES=2

# Drop stations whose autoscaling confidence is below this. Ionosonde
# autoscaling is unreliable enough that a low-confidence reading is worse than
# no reading.
#SOLARHAM_KC2G_MIN_CONFIDENCE=25

# Drop stations whose own timestamp is older than this. The document is served
# fresh even when a station inside it has been silent for months.
#SOLARHAM_KC2G_MAX_AGE=3h

# Restrict to specific URSI codes. Empty publishes every station worldwide,
# which is a lot of series for a dashboard that cares about a few nearby.
#SOLARHAM_KC2G_STATIONS=

#SOLARHAM_KC2G_EFFECTIVE_INDICES=true    # effective SSN and flux

# ---------------------------------------------------------------------------
# Sink: Prometheus
#
# Pull-based. Point a scrape at SOLARHAM_HTTP_ADDR + the path below.
# ---------------------------------------------------------------------------

#SOLARHAM_PROMETHEUS_ENABLED=true
#SOLARHAM_PROMETHEUS_PATH=/metrics

# How long a series stays on /metrics after it was last observed. Zero derives
# it from the owning source's interval. A series whose upstream stopped
# reporting must eventually disappear rather than sit at its last value.
#SOLARHAM_PROMETHEUS_RETENTION=0

# ---------------------------------------------------------------------------
# Sink: InfluxDB 2.x
#
# EXACTLY ONE of ORG or ORG_ID is required. Bucket-scoped tokens cannot resolve
# an organisation by name, so if writes 404 with "organization not found" while
# the name looks right, use ORG_ID. That, plus a bucket name whose case did not
# match, is why the predecessor container silently wrote nothing at all for its
# entire lifetime.
# ---------------------------------------------------------------------------

#SOLARHAM_INFLUX2_ENABLED=false
#SOLARHAM_INFLUX2_URL=http://influxdb:8086
#SOLARHAM_INFLUX2_ORG=
#SOLARHAM_INFLUX2_ORG_ID=
#SOLARHAM_INFLUX2_BUCKET=SolarHAM
#SOLARHAM_INFLUX2_TOKEN=
#SOLARHAM_INFLUX2_TOKEN_FILE=            # preferred over TOKEN
#SOLARHAM_INFLUX2_MEASUREMENT=solar
#SOLARHAM_INFLUX2_TIMEOUT=10s
#SOLARHAM_INFLUX2_RETRIES=2

# ---------------------------------------------------------------------------
# Sink: InfluxDB 1.x
# ---------------------------------------------------------------------------

#SOLARHAM_INFLUX1_ENABLED=false
#SOLARHAM_INFLUX1_URL=http://influxdb:8086
#SOLARHAM_INFLUX1_DATABASE=solarham
#SOLARHAM_INFLUX1_RETENTION_POLICY=
#SOLARHAM_INFLUX1_USERNAME=
#SOLARHAM_INFLUX1_PASSWORD=
#SOLARHAM_INFLUX1_PASSWORD_FILE=         # preferred over PASSWORD
#SOLARHAM_INFLUX1_MEASUREMENT=solar
#SOLARHAM_INFLUX1_TIMEOUT=10s
#SOLARHAM_INFLUX1_RETRIES=2

# ---------------------------------------------------------------------------
# Sink: OTLP
# ---------------------------------------------------------------------------

#SOLARHAM_OTLP_ENABLED=false
#SOLARHAM_OTLP_PROTOCOL=grpc             # grpc | http
#SOLARHAM_OTLP_ENDPOINT=
#SOLARHAM_OTLP_INSECURE=false
#SOLARHAM_OTLP_HEADERS=                  # comma-separated key=value
#SOLARHAM_OTLP_INTERVAL=60s
#SOLARHAM_OTLP_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Sink: MQTT and Home Assistant
#
# Discovery publishes a retained config document per series once, on first
# sight, so the entities appear in Home Assistant without manual setup. An
# availability topic with a last will means HA marks them unavailable when this
# exporter stops, rather than showing stale numbers indefinitely.
# ---------------------------------------------------------------------------

#SOLARHAM_MQTT_ENABLED=false
#SOLARHAM_MQTT_BROKER=tcp://mosquitto:1883
#SOLARHAM_MQTT_CLIENT_ID=solarham-exporter
#SOLARHAM_MQTT_USERNAME=
#SOLARHAM_MQTT_PASSWORD=
#SOLARHAM_MQTT_PASSWORD_FILE=            # preferred over PASSWORD
#SOLARHAM_MQTT_TOPIC=solarham
#SOLARHAM_MQTT_QOS=0
#SOLARHAM_MQTT_RETAIN=true
#SOLARHAM_MQTT_TIMEOUT=10s
#SOLARHAM_MQTT_DISCOVERY_ENABLED=true
#SOLARHAM_MQTT_DISCOVERY_PREFIX=homeassistant
#SOLARHAM_MQTT_DEVICE_ID=solarham
#SOLARHAM_MQTT_DEVICE_NAME=SolarHAM

# ---------------------------------------------------------------------------
# Deprecated: the predecessor container's variables
#
# The Python image took two lowercase variables. Both are still accepted so the
# image can be swapped without editing the container, and either one implies
# SOLARHAM_INFLUX2_ENABLED=true. Both log a deprecation warning naming the
# modern setting. Setting a legacy variable and its modern equivalent together
# is an error rather than a silent precedence rule.
#
#   url    ->  SOLARHAM_INFLUX2_URL
#   token  ->  SOLARHAM_INFLUX2_TOKEN
#
# Note that neither supplies an organisation, so a drop-in upgrade still needs
# SOLARHAM_INFLUX2_ORG_ID (or _ORG) added. Startup fails with a message saying
# so, which is the intended improvement on 404ing silently forever.
# ---------------------------------------------------------------------------

# ===========================================================================
# ADDITIONAL SOURCES
#
# Everything below was added after the initial release. Two conventions run
# through all of it.
#
# CADENCE. An interval is only configurable where the upstream genuinely
# changes continuously. Where it publishes on a known clock the schedule is
# fixed in code and there is no interval to set, because an operator has no way
# to know better than the publisher does. DRAO measures the solar flux at 17:00,
# 20:00 and 23:00 UT, so it is polled three times a day; the ARRL activity file
# is rebuilt weekly, so it is polled once a day and answers 304 most of the
# time. Polling either every few minutes would fetch an identical document
# hundreds of times to learn nothing.
#
# LICENCE. Sources whose data carries a non-commercial or otherwise restricted
# licence default to DISABLED. Nobody should inherit a licence obligation from
# a default they did not read. Those are grouped at the end.
#
# Request spacing is enforced per host across every source that shares it, so
# enabling another NOAA source costs nothing extra in request rate.
# ===========================================================================

# ---------------------------------------------------------------------------
# NOAA SWPC forecasts and active regions
#
# Flare probability is arguably the most actionable number in this exporter:
# an X-class probability is a direct forecast of an HF blackout on the sunlit
# side. Regenerated daily, so polled four times a day -- "issued daily" is a
# plan rather than a guarantee, and SWPC reissues when a forecaster revises.
# ---------------------------------------------------------------------------

#SOLARHAM_SOLAR_PROBABILITIES_ENABLED=true

# Per-region flare probabilities in addition to the aggregates. Region numbers
# churn as regions rotate across the disc, so these series do not survive
# week-to-week comparison. The aggregates do.
#SOLARHAM_SOLAR_PROBABILITIES_REGIONS=false

# ---------------------------------------------------------------------------
# NOAA GloTEC -- total electron content
#
# The near-real-time TEC service, regenerated every ten minutes. Its anomaly
# field is TEC relative to the quiet-time expectation, which is a storm
# indicator needing no baseline work of your own.
# ---------------------------------------------------------------------------

#SOLARHAM_GLOTEC_ENABLED=true

# Locations to sample, as name=lat,lon pairs.
#
# Pick land. The grid's quality flag counts how many GNSS observations were
# assimilated into each cell, and roughly three quarters of cells are zero --
# mostly ocean, where there are no receivers. A point over open water
# legitimately produces no samples rather than a modelled guess.
# Pairs are separated by semicolons, because each value already contains a
# comma.
#SOLARHAM_GLOTEC_POINTS=home=35.78,-78.64;europe=51.5,-0.13

# Summary statistics per 30-degree latitude band. Cheap: 18 series.
#SOLARHAM_GLOTEC_LATITUDE_BANDS=true

# The full 5,184-point grid, subsampled by GRID_STEP on both axes. At step 1
# this is more series than everything else in the exporter combined, which is
# why it is off. Startup logs the series count when you enable it.
#SOLARHAM_GLOTEC_GRID=false
#SOLARHAM_GLOTEC_GRID_STEP=10

# ---------------------------------------------------------------------------
# NASA CCMC iSWA -- real-time solar wind
#
# This restores the real-time solar wind that SWPC retired: its
# /products/solar-wind/ directory now returns 404 everywhere it is still cited.
# iSWA also carries ACE, Wind and IMAP, which are independent cross-checks
# against DSCOVR rather than additional data.
# ---------------------------------------------------------------------------

#SOLARHAM_ISWA_ENABLED=true
#SOLARHAM_ISWA_BASE_URL=https://iswa.gsfc.nasa.gov/hapi
#SOLARHAM_ISWA_FAST_INTERVAL=1m

# Which L1 monitors to publish. More than one is rarely useful; they measure
# the same solar wind from nearly the same place.
#SOLARHAM_ISWA_SPACECRAFT=swpc

#SOLARHAM_ISWA_TIMEOUT=20s
#SOLARHAM_ISWA_RETRIES=2

# ---------------------------------------------------------------------------
# NASA CCMC DONKI -- coronal mass ejections and flare events
#
# Uses the CCMC host rather than api.nasa.gov. They serve byte-identical JSON,
# but api.nasa.gov's demo key measured a limit of ten requests an hour, which
# makes polling impossible. CCMC needs no key and publishes no limit.
#
# This is an event catalogue, curated with a lag, so it is modelled as counts
# over a rolling window rather than as instantaneous gauges.
# ---------------------------------------------------------------------------

#SOLARHAM_DONKI_ENABLED=true
#SOLARHAM_DONKI_BASE_URL=https://webtools.ccmc.gsfc.nasa.gov/DONKI/WS/get
#SOLARHAM_DONKI_INTERVAL=30m
#SOLARHAM_DONKI_WINDOW=72h
#SOLARHAM_DONKI_TIMEOUT=20s
#SOLARHAM_DONKI_RETRIES=2

# ---------------------------------------------------------------------------
# USGS geomagnetism
#
# Field rate-of-change in nT/min, computed server-side. Note there is no USGS
# Kp or Dst endpoint -- the widely cited one returns 404 and never existed.
# ---------------------------------------------------------------------------

#SOLARHAM_USGS_GEOMAG_ENABLED=true
#SOLARHAM_USGS_GEOMAG_BASE_URL=https://geomag.usgs.gov

# IAGA codes. The service lists forty, of which about fourteen are test or
# duplicate channels, so the default is a curated set rather than all of them.
#SOLARHAM_USGS_GEOMAG_OBSERVATORIES=BOU,FRD,NEW,TUC,SIT

#SOLARHAM_USGS_GEOMAG_INTERVAL=5m
#SOLARHAM_USGS_GEOMAG_TIMEOUT=20s
#SOLARHAM_USGS_GEOMAG_RETRIES=2

# ---------------------------------------------------------------------------
# GFZ Potsdam -- the definitive Kp, plus Hp30
#
# CC BY 4.0, so no restriction. Hp30 is the reason to have this: thirty-minute
# geomagnetic resolution at about eleven minutes latency, which NOAA does not
# publish at any cadence. The k_index_estimated series from SWPC is a
# US-subnetwork estimate; this is the definitive product.
# ---------------------------------------------------------------------------

#SOLARHAM_GFZ_ENABLED=true
#SOLARHAM_GFZ_BASE_URL=https://kp.gfz.de
#SOLARHAM_GFZ_HALF_HOURLY=true
#SOLARHAM_GFZ_INTERVAL=10m
#SOLARHAM_GFZ_TIMEOUT=20s
#SOLARHAM_GFZ_RETRIES=2

# ---------------------------------------------------------------------------
# DRAO Penticton -- the 10.7 cm flux, from the instrument that measures it
#
# No interval setting. Penticton measures three times per UT day at 17:00,
# 20:00 and 23:00, and the table is published with about a day's lag, so the
# schedule is fixed in code: three polls a day rather than 288. The file is
# 2 MB of history and is fetched with a Range request for the tail.
# ---------------------------------------------------------------------------

#SOLARHAM_DRAO_ENABLED=true
#SOLARHAM_DRAO_BASE_URL=https://www.spaceweather.gc.ca
#SOLARHAM_DRAO_TIMEOUT=30s
#SOLARHAM_DRAO_RETRIES=2

# ---------------------------------------------------------------------------
# LASP -- SDO/EVE irradiance and the LISIRD datasets
#
# EVE publishes, uniquely, the heliographic centroid of EUV emission at
# one-minute cadence: effectively where on the disc the dominant activity is
# right now. LISIRD adds total solar irradiance, Mg II, Lyman-alpha and the
# multi-frequency radio flux, all as daily datasets in roughly 1 KB responses.
# ---------------------------------------------------------------------------

#SOLARHAM_LASP_ENABLED=true
#SOLARHAM_LASP_BASE_URL=https://lasp.colorado.edu
#SOLARHAM_LASP_EVE=true
#SOLARHAM_LASP_LISIRD=true
#SOLARHAM_LASP_TIMEOUT=20s
#SOLARHAM_LASP_RETRIES=2

# ---------------------------------------------------------------------------
# FMI -- regional auroral activity, Finland
#
# CC BY 4.0. This is a measurement of the ground response, where OVATION is a
# model of particle precipitation.
#
# Only the index JSON is fetched. FMI's raw realtime magnetometer files carry a
# different statement -- they must not be redistributed from other servers --
# and are deliberately not touched.
# ---------------------------------------------------------------------------

#SOLARHAM_FMI_ENABLED=true
#SOLARHAM_FMI_BASE_URL=https://space.fmi.fi
#SOLARHAM_FMI_INTERVAL=5m
#SOLARHAM_FMI_TIMEOUT=20s
#SOLARHAM_FMI_RETRIES=2

# ---------------------------------------------------------------------------
# KiwiSDR -- your own measured noise floor
#
# The only direct noise-floor measurement in this whole exporter. No regulator
# publishes one, in any jurisdiction.
#
# Point this at YOUR receiver. The endpoint is unauthenticated on any public
# KiwiSDR, but those are private machines somebody chose to share, and polling
# one on a schedule without asking is not on. Off by default because it needs
# an address.
# ---------------------------------------------------------------------------

#SOLARHAM_KIWISDR_ENABLED=false
#SOLARHAM_KIWISDR_RECEIVERS=shack=http://192.168.1.50:8073
#SOLARHAM_KIWISDR_INTERVAL=30m
#SOLARHAM_KIWISDR_TIMEOUT=15s
#SOLARHAM_KIWISDR_RETRIES=1

# ---------------------------------------------------------------------------
# ARRL Logbook of the World -- how many operators are actually on the air
#
# No interval setting. The file is 6 MB and rebuilt roughly weekly, so it is
# fetched once a day with a conditional request that answers 304 most days. The
# activity windows are computed against the file's own Last-Modified rather
# than the wall clock, or the counts would drift downward as it ages.
# ---------------------------------------------------------------------------

#SOLARHAM_LOTW_ENABLED=true
#SOLARHAM_LOTW_URL=https://lotw.arrl.org/lotw-user-activity.csv
#SOLARHAM_LOTW_TIMEOUT=2m
#SOLARHAM_LOTW_RETRIES=1

# ---------------------------------------------------------------------------
# Parks on the Air
#
# Spots carry their own expiry upstream, so the activator feed is already a
# snapshot of what is on the air rather than a running log.
# ---------------------------------------------------------------------------

#SOLARHAM_POTA_ENABLED=true
#SOLARHAM_POTA_BASE_URL=https://api.pota.app
#SOLARHAM_POTA_INTERVAL=60s
#SOLARHAM_POTA_TIMEOUT=20s
#SOLARHAM_POTA_RETRIES=2

# ---------------------------------------------------------------------------
# Celestrak -- orbital element-set freshness
#
# Freshness only. Pass predictions are deliberately not published: a countdown
# is a computed function of time, wrong between scrapes, quantised to the
# scrape interval, and it reconstructs badly in any range query. Element-set
# age is a real fact about the outside world, and stale elements are a genuine
# operational problem worth alerting on.
#
# No interval setting. Celestrak's terms prohibit high-frequency automated
# retrieval and element sets change daily, so this runs on a daily schedule.
# ---------------------------------------------------------------------------

#SOLARHAM_CELESTRAK_ENABLED=true
#SOLARHAM_CELESTRAK_BASE_URL=https://celestrak.org
#SOLARHAM_CELESTRAK_GROUP=amateur
#SOLARHAM_CELESTRAK_TIMEOUT=30s
#SOLARHAM_CELESTRAK_RETRIES=1

# ===========================================================================
# RESTRICTED-LICENCE SOURCES
#
# All of these default to DISABLED. Enabling one accepts its licence. Startup
# logs each enabled restricted source and its terms so the obligation is
# visible in the logs rather than only in this file.
# ===========================================================================

# ---------------------------------------------------------------------------
# wspr.live -- observed propagation, per band
#
# NON-COMMERCIAL. Their terms also ask that results be accessible free of
# charge to everyone, which a private dashboard arguably is not -- worth a
# thought before enabling.
#
# Architecturally the best fit in the exporter: a ClickHouse SQL endpoint, so
# one GROUP BY query returns the whole gauge set server-side at 17-value
# cardinality. Their documented limit is twenty requests a minute shared
# between all users; one query every five minutes sits far inside it.
# ---------------------------------------------------------------------------

#SOLARHAM_WSPR_LIVE_ENABLED=false
#SOLARHAM_WSPR_LIVE_BASE_URL=https://db1.wspr.live
#SOLARHAM_WSPR_LIVE_INTERVAL=5m
#SOLARHAM_WSPR_LIVE_WINDOW=15m
#SOLARHAM_WSPR_LIVE_TIMEOUT=20s
#SOLARHAM_WSPR_LIVE_RETRIES=2

# ---------------------------------------------------------------------------
# PSK Reporter -- band activity
#
# The operator asks in writing for no more than one request every five minutes,
# and asks that automated clients supply a contact address so he can get in
# touch before blocking them.
#
# CONTACT IS REQUIRED. Startup fails without it. That refusal is deliberate:
# enabling this source anonymously against a stated request is not something
# the exporter will do on your behalf.
# ---------------------------------------------------------------------------

#SOLARHAM_PSKREPORTER_ENABLED=false
#SOLARHAM_PSKREPORTER_BASE_URL=https://pskreporter.info
#SOLARHAM_PSKREPORTER_CONTACT=you@example.com

# Maidenhead prefixes to request. Each one costs a request against a
# five-minute budget, so keep the list short. Empty asks for the global figure.
#SOLARHAM_PSKREPORTER_GRIDS=FM05

#SOLARHAM_PSKREPORTER_INTERVAL=5m
#SOLARHAM_PSKREPORTER_TIMEOUT=20s
#SOLARHAM_PSKREPORTER_RETRIES=1

# ---------------------------------------------------------------------------
# NMDB -- neutron monitors, galactic cosmic rays
#
# NON-COMMERCIAL. Acknowledge NMDB and the individual monitor PIs; the response
# carries a generated per-station acknowledgement which is logged at startup.
#
# NOAA has no equivalent: GOES protons are solar energetic particles, where
# these counts are galactic cosmic ray intensity, and a sudden drop is a
# Forbush decrease following a CME. One multi-station query is made rather than
# several single-station ones, because NEST queries MySQL per request.
# ---------------------------------------------------------------------------

#SOLARHAM_NMDB_ENABLED=false
#SOLARHAM_NMDB_BASE_URL=https://www.nmdb.eu
#SOLARHAM_NMDB_STATIONS=OULU,KIEL2,SOPO
#SOLARHAM_NMDB_INTERVAL=10m
#SOLARHAM_NMDB_TIMEOUT=30s
#SOLARHAM_NMDB_RETRIES=1

# ---------------------------------------------------------------------------
# INTERMAGNET -- ground magnetometer observatories
#
# CC BY-NC. Acknowledge the operating institutes; they are logged at startup
# from the data itself.
#
# Raw per-observatory field vectors at about three minutes latency -- the input
# from which Kp and Dst are derived, rather than a derived index.
#
# Several observatories embargo their data and return nulls rather than an
# error, and the capabilities table understates this: two stations advertising
# no embargo return a full day of nulls. Configured stations are therefore
# probed on the first poll and excluded with a warning if unusable, then
# re-probed every six hours in case they start reporting.
# ---------------------------------------------------------------------------

#SOLARHAM_INTERMAGNET_ENABLED=false
#SOLARHAM_INTERMAGNET_BASE_URL=https://imag-data.bgs.ac.uk

# IAGA codes. The network has 154 observatories; iterating all of them is
# about 13 MB per poll, most of it embargoed, absent or hours stale.
#SOLARHAM_INTERMAGNET_OBSERVATORIES=BOU,FRD,CLF,HRN,BEL

#SOLARHAM_INTERMAGNET_INTERVAL=5m
#SOLARHAM_INTERMAGNET_TIMEOUT=30s
#SOLARHAM_INTERMAGNET_RETRIES=2

# ---------------------------------------------------------------------------
# SILSO -- the International Sunspot Number
#
# CC BY-NC. Required citation:
#   Source: WDC-SILSO, Royal Observatory of Belgium, Brussels
#   DOI: https://doi.org/10.24414/qnza-ac80
#
# This is the authoritative sunspot number, where the SWPC figure is a relayed
# derivative. It also carries the 13-month smoothed series, which has no NOAA
# machine-readable equivalent.
#
# No interval setting. The current-month estimate is 414 bytes and is polled a
# few times a day; the smoothed monthly series is polled daily at most. The
# full daily series is 2.9 MB and is never polled.
# ---------------------------------------------------------------------------

#SOLARHAM_SILSO_ENABLED=false
#SOLARHAM_SILSO_BASE_URL=https://www.sidc.be
#SOLARHAM_SILSO_TIMEOUT=20s
#SOLARHAM_SILSO_RETRIES=2
